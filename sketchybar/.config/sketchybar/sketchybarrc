#!/usr/bin/env bash
# SketchyBar — https://felixkratz.github.io/SketchyBar/
# Visual direction: "Phosphor" — dark frosted glass framed by the same
# accent-blue hairline glow as the JankyBorders window borders; structure
# drawn with 1px luminous strokes, not fills; Monaspace labels.
#
# Complements (never duplicates) the macOS menu bar OR the tmux statusline:
# per-agent fleet pills showing current state, PRs awaiting review, Claude
# usage when running hot, now-playing. Workspaces live in OmniWM's own
# workspace bar at the bottom edge (native app icons, no IPC round-trip);
# this bar only carries what OmniWM's bar can't show.
#
# Event flow (all push, polling only where no push exists):
#   fleet hook status files -> bin/sketchybar-fleet-watch (fswatch)
#     -> fleet_state_change -> plugins/fleet_pills.sh (per-agent pills)
#   bin/claude-statusline tee -> claude_usage_update -> plugins/usage.sh
#   music: 10s poll (AppleScript has no push surface)

CONFIG_DIR="${CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
DOTFILES_BIN="$HOME/bin" # ~/bin -> dotfiles/bin/bin (stable, PATH-independent)
source "$CONFIG_DIR/colors.sh"

GAUGE=$(printf '\xf3\xb0\x89\x81') # nf-md-gauge  U+F0241
GITHUB=$(printf '\xef\x82\x9b')    # nf-fa-github U+F09B

MONO="Monaspace Neon"

# ── Bar: invisible strip; the glass is the right_island bracket ──
# y_offset 34 = the 30pt macOS menu bar + 4, so the bar stays clear of the
# menu bar when it auto-shows. SketchyBar's margin is symmetric, so
# the bar itself spans the screen with no fill, and the dark glass with
# its live edge is drawn only behind the right-side items (see the end).
sketchybar --bar \
  position=top \
  height=30 \
  margin=0 \
  y_offset=34 \
  corner_radius=0 \
  blur_radius=0 \
  color="$TRANSPARENT" \
  border_width=0 \
  shadow=off \
  padding_left=12 \
  padding_right=12 \
  display=all

sketchybar --hotload true

# ── Defaults: every chip has a visible fill AND a resting hairline ─
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font Mono:Regular:14.0" \
  icon.color="$GREY" \
  label.font="$MONO:Regular:12.0" \
  label.color="$FG" \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_left=2 \
  label.padding_right=8 \
  padding_left=6 \
  padding_right=6 \
  background.corner_radius=4 \
  background.height=24 \
  background.color="$ITEM_BG" \
  background.border_width=1 \
  background.border_color="$HAIRLINE" \
  popup.background.color="$POPUP_BG" \
  popup.background.corner_radius=6 \
  popup.background.border_width=1 \
  popup.background.border_color="$POPUP_BORDER" \
  popup.blur_radius=30

# ── Events ───────────────────────────────────────────────────────
sketchybar --add event fleet_state_change \
  --add event claude_usage_update

# ── Right: fleet agent pills · spend ─────────────────────────────
# One pill per live agent (fleet), rendered by fleet_pills.sh in a single
# batched call. Inline pool agent.1..5; overflow into agent.more's popup
# (agent.pop.1..15). Push via fleet_state_change (fswatch); update_freq is a
# backstop that reaps pills whose pane closed without writing a status file.
FLEET_POOL=5
FLEET_POPUP_POOL=15

sketchybar --add item fleet_controller right \
  --subscribe fleet_controller fleet_state_change \
  --set fleet_controller drawing=off width=0 \
  update_freq=30 \
  script="$PLUGIN_DIR/fleet_pills.sh"

# Inline pills. Added high-index-first so agent.1 sits leftmost in the group.
# TODO: verify pill order once >5 agents run — agent.more currently renders
# left of agent.1..5; flip this seq direction if the cluster reads backwards.
for i in $(seq "$FLEET_POOL" -1 1); do
  sketchybar --add item agent."$i" right \
    --set agent."$i" \
    drawing=off \
    label.max_chars=8 \
    icon.font="JetBrainsMono Nerd Font Mono:Regular:13.0"
done

# Overflow badge + popup rows (rows anchor on agent.more's popup).
sketchybar --add item agent.more right \
  --set agent.more drawing=off icon="⋯" icon.color="$GREY"
for j in $(seq 1 "$FLEET_POPUP_POOL"); do
  sketchybar --add item agent.pop."$j" popup.agent.more \
    --set agent.pop."$j" drawing=off label.max_chars=40 \
    icon.font="JetBrainsMono Nerd Font Mono:Regular:13.0"
done

# spend: running daily dollar total across claude/codex/pi via
# `sessions report` — placed beside the agents it measures
sketchybar --add item spend right \
  --set spend \
  icon="$" \
  icon.font="$MONO:Bold:12.0" \
  update_freq=900 \
  drawing=off \
  script="$PLUGIN_DIR/spend.sh"

# The agent instrument cluster shares one shelf outline. Explicit item
# list (not a /agent\..*/ regex)
# so the popup rows stay out of the bar bracket.
sketchybar --add bracket agent_cluster spend agent.more agent.5 agent.4 agent.3 agent.2 agent.1 \
  --set agent_cluster \
  background.color="$TRANSPARENT" \
  background.border_width=1 \
  background.border_color="$GLOW_TRACE" \
  background.corner_radius=6 \
  background.height=28

sketchybar --add item github right \
  --set github \
  icon="$GITHUB" \
  icon.color="$FG" \
  update_freq=300 \
  click_script="omniwmctl workspace focus-name W; open https://github.com/pulls/review-requested" \
  script="$PLUGIN_DIR/github.sh"

# usage: hidden until the 5h Claude window runs hot (>=70%)
sketchybar --add item usage right \
  --subscribe usage claude_usage_update \
  --set usage \
  icon="$GAUGE" \
  update_freq=300 \
  drawing=off \
  script="$PLUGIN_DIR/usage.sh"

# now-playing: added last so it sits innermost, nearest the center
sketchybar --add item music right \
  --set music \
  icon="♪" \
  icon.color="$MAGENTA" \
  label.max_chars=28 \
  scroll_texts=on \
  update_freq=10 \
  drawing=off \
  script="$PLUGIN_DIR/music.sh"

# ── OmniWM lifeline ──────────────────────────────────────────────
# The bar only exists alongside the WM. OmniWM has no startup hook, so
# bin/sketchybar-omniwm-watch (launchd: com.jc.sketchybar-omniwm-watch,
# `./install.sh sketchybar-omniwm-watch`) launches the bar once OmniWM is
# up and exits it when OmniWM's IPC connection drops. It sends no events:
# nothing on this bar depends on workspace or focus state any more.

# ── Fleet push watcher ───────────────────────────────────────────
# Owned by launchd: com.jc.sketchybar-fleet-watch (RunAtLoad + KeepAlive),
# installed by `./install.sh sketchybar-fleet-watch`. Spawning it from here
# did not survive a config reload, which silently dropped the pills back to
# fleet_controller's 30s update_freq and read as "never updating".

# Right island: the old bar glass, behind every right-side item. Explicit
# list so agent.more's popup rows stay out of it.
sketchybar --add bracket right_island music usage github \
  spend agent.more agent.5 agent.4 agent.3 agent.2 agent.1 \
  --set right_island \
  background.color="$BAR_COLOR" \
  background.border_width=1 \
  background.border_color="$BAR_BORDER" \
  background.corner_radius=10 \
  background.height=30 \
  background.shadow.drawing=on

# Force every item to run its script once so the bar starts populated
sketchybar --update
