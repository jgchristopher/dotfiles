<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jc.sketchybar-omniwm-watch</string>

    <!--
      Owns the bar's lifetime: launches sketchybar once OmniWM is running,
      exits it when OmniWM quits. OmniWM has no after-startup-command hook,
      so this stands in for the one aerospace.toml used.

      Launchd for the same reason as sketchybar-fleet-watch: a watcher
      spawned from sketchybarrc does not survive a config reload.

      AbandonProcessGroup: the watcher launches sketchybar as its child.
      Without this, launchd kills the bar whenever it restarts the watcher.
      The cost: unloading the agent leaves its omniwmctl subscribe child
      running. Kill it by hand.
    -->

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/bin/sketchybar-omniwm-watch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>AbandonProcessGroup</key>
    <true/>

    <!-- omniwmctl, sketchybar, and brew bash/jq for the bar's plugins. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/sketchybar-omniwm-watch/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/sketchybar-omniwm-watch/stderr.log</string>
</dict>
</plist>
