#!/usr/bin/env bash
# Emit "state|pane|session|tool" per live agent, sorted by urgency then
# session. Reads "pane|session" lines on stdin — the live agent panes the
# caller discovered (e.g. fleet_pills.sh scans tmux panes for a claude/codex/pi
# descendant). For each pane, state fuses its fleet .status snapshot with the
# tail of its .events.jsonl (mirroring fleet's own state engine); the status
# file's session/tool are authoritative. A pane with NO status file — a
# brand-new session that hasn't fired a hook yet — falls back to idle with the
# passed-in session label, so it still shows up (matching fleet's TUI).
# If the user titled the Claude session (/rename), that title replaces the
# session label — see the registry lookup below.
# Normalized states: waiting asking done working idle.
# FLEET_STATUS_ROOT overrides the cache root (default ~/.cache) for tests.
# FLEET_TMUX_PID overrides the live tmux server pid (default: ask tmux) for tests.
# FLEET_SESSIONS_DIR overrides Claude Code's session registry dir for tests.

ROOT="${FLEET_STATUS_ROOT:-$HOME/.cache}"

# tmux pane ids are only unique within ONE server lifetime — they restart at %0
# whenever the server does. So a bare "%N -> N.status" match happily adopts a
# file written weeks ago by a dead server's pane, and the bar shows a plausible
# but wrong session. Each status file records the tmux server pid that owned it;
# anything from another server is treated as absent. If the live pid can't be
# determined (no tmux), skip the check rather than dropping every agent.
LIVE_TMUX_PID="${FLEET_TMUX_PID:-$(tmux display-message -p '#{pid}' 2>/dev/null)}"

# Claude Code keeps a live-session registry at ~/.claude/sessions/<pid>.json:
# {pid, tmux: "sess:@win.%pane", name, nameSource, ...}. A title the user set
# with /rename has nameSource "user"; auto-generated ones are "derived" and are
# skipped. Entries outlive their process and pane ids recycle across tmux
# servers, so an entry only counts while its claude pid is alive. Pipes and
# control chars are scrubbed from the title because the row format is
# pipe-delimited. Result: "pane<TAB>name" lines, one per user-named live pane.
SESSIONS_DIR="${FLEET_SESSIONS_DIR:-$HOME/.claude/sessions}"
NAMES=""
if [ -d "$SESSIONS_DIR" ] && command -v jq >/dev/null 2>&1; then
  for f in "$SESSIONS_DIR"/*.json; do
    [ -e "$f" ] || continue
    IFS=$'\t' read -r pid pane name < <(jq -r '
      select(.nameSource == "user" and ((.name // "") != "")
             and ((.tmux // "") | test("\\.%[0-9]+$")))
      | [(.pid | tostring),
         (.tmux | capture("\\.(?<p>%[0-9]+)$").p),
         (.name | gsub("[|\\n\\r\\t]"; " "))]
      | @tsv' "$f" 2>/dev/null)
    [ -n "$pid" ] && [ -n "$pane" ] && [ -n "$name" ] || continue
    kill -0 "$pid" 2>/dev/null || continue
    NAMES="${NAMES}${pane}	${name}
"
  done
fi

name_for_pane() {
  printf '%s' "$NAMES" | awk -F'\t' -v p="$1" '$1 == p { print $2; exit }'
}

# Derive "state|session|tool" from one .status file fused with its event log.
derive() {
  local sf="$1"
  tail -n 25 "${sf%.status}.events.jsonl" 2>/dev/null |
    jq -crsR --slurpfile st "$sf" '
      [splits("\n") | select(length > 0) | fromjson?] as $ev
      | $st[0] as $s
      | ($ev | last) as $l
      | (if $l == null then null
         elif $l.event == "Acknowledged" then "idle"
         elif $l.event == "Stop" or $l.event == "SubagentStop" then
           (if $l.background_tasks == true or $l.stop_reason == "tool_use"
            then "working" else "done" end)
         elif $l.event == "PreToolUse" then
           (if $l.tool == "AskUserQuestion" then "question" else "working" end)
         elif $l.event == "Notification" then
           (if $l.notification_type == "elicitation_dialog" then "question"
            elif $l.notification_type == "idle_prompt" then "done"
            elif $l.notification_type == "permission_prompt" then
              (($ev[0:-1] | reverse | map(select(
                  .event == "Stop" or .event == "SubagentStop"
                  or .event == "PreToolUse")) | first // null) as $t
               | if $t != null and $t.event == "PreToolUse"
                   and $t.tool == "AskUserQuestion"
                 then "question" else "permit" end)
            else null end)
         else null end) as $derived
      | ($derived // {waiting: "permit", completed: "done"}[$s.state] // $s.state) as $raw
      | ($raw | if . == "permit" then "waiting"
                elif . == "question" then "asking" else . end) as $state
      | "\($state)|\($s.session)|\($s.tool)"
    ' 2>/dev/null
}

while IFS='|' read -r pane label; do
  [ -n "$pane" ] || continue
  num="${pane#%}"
  sf=""
  for dir in claude codex pi; do
    f="$ROOT/${dir}-status/${num}.status"
    [ -e "$f" ] || continue
    if [ -n "$LIVE_TMUX_PID" ]; then
      fpid=$(jq -r '.tmux_pid // empty' "$f" 2>/dev/null)
      [ -n "$fpid" ] && [ "$fpid" != "$LIVE_TMUX_PID" ] && continue
    fi
    sf="$f"
    break
  done
  state="idle" session="$label" tool=""
  if [ -n "$sf" ]; then
    IFS='|' read -r state session tool < <(derive "$sf")
    [ -n "$state" ] || state="idle"
    [ -n "$session" ] || session="$label"
  fi
  name=$(name_for_pane "$pane")
  [ -n "$name" ] && session="$name"
  printf '%s|%s|%s|%s\n' "$state" "$pane" "$session" "$tool"
done |
  awk -F'|' '
    { r = ($1=="waiting")?0:($1=="asking")?1:($1=="done")?2:($1=="working")?3:($1=="idle")?4:5
      print r "|" $0 }' |
  sort -t'|' -k1,1n -k4,4 |
  cut -d'|' -f2-
